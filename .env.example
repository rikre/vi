# Production auth service base URL. The server forwards same-origin /api/auth/*
# calls to the corresponding /auth/* endpoints under this base URL.
AUTH_API_BASE_URL=https://api.example.com/

# Development-only fallback: code 123456, password bollo123, and an 8-second
# WeChat QR flow. Keep false in production.
AUTH_MOCK_ENABLED=false

# ---------------------------------------------------------------------------
# Admin console database (PostgreSQL + Prisma)
# Start the local database with: docker compose up -d
# Then run migrations + seed with: npm run db:setup
DATABASE_URL="postgresql://bollo:bollo@localhost:5432/bollo_admin?schema=public"

# ---------------------------------------------------------------------------
# Model API key storage adapter
# - Production: point both values at your KMS/Vault; only the secret reference
#   and last 4 characters are persisted.
# - Local development: leave KMS_* empty and set ADMIN_SECRET_ENCRYPTION_KEY to
#   a 32-byte base64 string (generate with: openssl rand -base64 32).
KMS_API_BASE_URL=
KMS_API_KEY=
ADMIN_SECRET_ENCRYPTION_KEY=
